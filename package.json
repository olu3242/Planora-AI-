{
  "name": "planora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Governed financial planning, analysis, and decision intelligence platform.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "tsx scripts/run-isolated-integration.ts",
    "test:financial": "vitest run tests/financial-calculations",
    "test:excel": "vitest run tests/excel",
    "test:security": "vitest run tests/security tests/auth tests/rbac",
    "test:performance": "vitest run tests/performance",
    "test:e2e": "playwright test",
    "test:e2e:responsive": "playwright test --grep @responsive",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:test": "tsx scripts/migrate-test.ts",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:status:test": "tsx scripts/migrate-test.ts status",
    "db:reset:test": "tsx database/reset-test.ts",
    "db:seed": "tsx database/seeds/index.ts",
    "db:seed:test": "tsx scripts/seed-test.ts",
    "db:generate": "prisma generate",
    "certify": "npm run db:generate && npm run db:validate && npm run db:reset:test && npm run db:seed:test && npm run db:status:test && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:financial && npm run test:excel && npm run test:security && npm run test:performance && npm run db:reset:test && npm run db:seed:test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@prisma/client": "6.19.1",
    "@tailwindcss/postcss": "^4.3.3",
    "csv-parse": "^7.0.3",
    "decimal.js": "10.6.0",
    "dotenv": "17.2.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "1.37.0",
    "next": "^16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.0",
    "istanbul-lib-coverage": "^3.2.2",
    "prisma": "6.19.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "effect": "3.20.0",
    "uuid": "11.1.1"
  }
}
