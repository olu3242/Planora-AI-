{
  "name": "planora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Governed financial planning, analysis, and decision intelligence platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:financial": "vitest run tests/financial-calculations",
    "test:excel": "vitest run tests/excel",
    "test:security": "vitest run tests/security tests/auth tests/rbac",
    "test:performance": "vitest run tests/performance",
    "test:e2e": "playwright test",
    "test:e2e:responsive": "playwright test --grep @responsive",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset:test": "tsx database/reset-test.ts",
    "db:seed": "tsx database/seeds/index.ts",
    "db:generate": "prisma generate",
    "certify": "npm run lint && npm run typecheck && npm run build && npm run test && npm run test:financial && npm run test:excel && npm run test:security && npm run test:performance && npm run db:reset:test && npm run db:seed && npm run test:e2e"
  },
  "dependencies": {
    "@prisma/client": "6.19.1",
    "csv-parse": "^6.1.0",
    "decimal.js": "10.6.0",
    "dotenv": "17.2.3",
    "exceljs": "^4.4.0",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "prisma": "6.19.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "effect": "3.20.0",
    "uuid": "11.1.1"
  }
}
