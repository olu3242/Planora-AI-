# Planora local development (matches compose.yaml)
DATABASE_URL="postgresql://planora:planora_local_only@127.0.0.1:55432/planora?schema=public"
SESSION_COOKIE_NAME="planora_session"
SESSION_TTL_HOURS="12"
APP_ENV="development"
APP_URL="http://127.0.0.1:3000"
AGENTIC_OS_ENABLED="true"
AGENT_EXECUTION_ENABLED="true"
AI_COMMENTARY_ENABLED="true"
