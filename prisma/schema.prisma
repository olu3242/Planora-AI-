model ExcelWorkbook {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  originalFileName  String
  sanitizedFileName String
  mimeType          String
  byteSize          Int
  sha256            String
  content           Bytes
  status            WorkbookStatus   @default(UPLOADED)
  uploadedAt        DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profile           WorkbookProfile?
  mappingVersions   MappingVersion[]
  importBatches     ImportBatch[]

  @@unique([organizationId, sha256])
  @@index([organizationId, uploadedAt])
}

model WorkbookProfile {
  id               String        @id @default(uuid()) @db.Uuid
  workbookId       String        @unique @db.Uuid
  fingerprint      String
  primaryShape     WorkbookShape
  sheetCount       Int
  formulaCount     Int
  hiddenSheetCount Int
  mergedCellCount  Int
  profile          Json
  profiledAt       DateTime      @default(now())
  workbook         ExcelWorkbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)

  @@index([fingerprint])
}

model MappingTemplate {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  fingerprint    String
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions       MappingVersion[]

  @@unique([organizationId, fingerprint])
}

model MappingVersion {
  id                String               @id @default(uuid()) @db.Uuid
  templateId        String               @db.Uuid
  workbookId        String?              @db.Uuid
  version           Int
  status            MappingVersionStatus @default(DRAFT)
  schemaFingerprint String
  createdAt         DateTime             @default(now())
  approvedAt        DateTime?
  template          MappingTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  workbook          ExcelWorkbook?       @relation(fields: [workbookId], references: [id], onDelete: Restrict)
  rules             MappingRule[]
  suggestions       MappingSuggestion[]
  importBatches     ImportBatch[]

  @@unique([templateId, version])
  @@index([workbookId])
}

model MappingRule {
  id               String         @id @default(uuid()) @db.Uuid
  mappingVersionId String         @db.Uuid
  kind             MappingKind
  sourceField      String
  targetConcept    String
  targetMemberId   String?
  confidence       Decimal        @db.Decimal(5, 4)
  reason           String
  mappingVersion   MappingVersion @relation(fields: [mappingVersionId], references: [id], onDelete: Cascade)

  @@unique([mappingVersionId, kind, sourceField, targetConcept])
}

model MappingSuggestion {
  id                String                  @id @default(uuid()) @db.Uuid
  mappingVersionId  String                  @db.Uuid
  kind              MappingKind
  sourceValue       String
  targetConcept     String
  suggestedTargetId String?
  confidence        Decimal                 @db.Decimal(5, 4)
  reason            String
  status            MappingSuggestionStatus
  createdAt         DateTime                @default(now())
  mappingVersion    MappingVersion          @relation(fields: [mappingVersionId], references: [id], onDelete: Cascade)
  decision          MappingDecision?

  @@unique([mappingVersionId, kind, sourceValue, targetConcept])
}

model MappingDecision {
  id               String                  @id @default(uuid()) @db.Uuid
  suggestionId     String                  @unique @db.Uuid
  decidedById      String                  @db.Uuid
  decision         MappingSuggestionStatus
  selectedTargetId String
  reason           String
  decidedAt        DateTime                @default(now())
  suggestion       MappingSuggestion       @relation(fields: [suggestionId], references: [id], onDelete: Restrict)
  decidedBy        User                    @relation(fields: [decidedById], references: [id], onDelete: Restrict)
}

model ImportBatch {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  workbookId       String            @db.Uuid
  mappingVersionId String            @db.Uuid
  importedById     String            @db.Uuid
  status           ImportBatchStatus @default(VALIDATING)
  rowCount         Int               @default(0)
  rejectedRowCount Int               @default(0)
  sourceTotals     Json?
  resultMetrics    Json?
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workbook         ExcelWorkbook     @relation(fields: [workbookId], references: [id], onDelete: Restrict)
  mappingVersion   MappingVersion    @relation(fields: [mappingVersionId], references: [id], onDelete: Restrict)
  importedBy       User              @relation(fields: [importedById], references: [id], onDelete: Restrict)
  errors           ImportError[]

  @@unique([workbookId, mappingVersionId])
  @@index([organizationId, startedAt])
}

model ImportError {
  id                 String             @id @default(uuid()) @db.Uuid
  importBatchId      String             @db.Uuid
  rowNumber          Int?
  code               String
  field              String?
  sourceValue        String?
  message            String
  blocking           Boolean            @default(true)
  severity           ValidationSeverity @default(ERROR)
  resolutionGuidance String?
  resolvedAt         DateTime?
  evidence           Json?
  batch              ImportBatch        @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([importBatchId, blocking])
}

