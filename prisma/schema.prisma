model FinancialFact {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  accountId        String              @db.Uuid
  fiscalPeriodId   String              @db.Uuid
  legalEntityId    String?             @db.Uuid
  businessUnitId   String?             @db.Uuid
  geographyId      String?             @db.Uuid
  productId        String?             @db.Uuid
  customerId       String?             @db.Uuid
  costCenterId     String?             @db.Uuid
  scenario         FinancialScenario
  currencyCode     String              @db.Char(3)
  amount           Decimal             @db.Decimal(24, 6)
  unit             String              @default("currency")
  sourceType       FinancialSourceType
  sourceIdentifier String
  sourceMetadata   Json?
  versionContext   String              @default("UNVERSIONED")
  dimensionKey     String
  grainKey         String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account          Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
